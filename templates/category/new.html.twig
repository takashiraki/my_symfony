{% extends 'base.html.twig' %}

{% block title %}New Category{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100">

        {# Navbar #}
        <header class="bg-white border-b border-gray-200 px-4 sm:px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-2 sm:gap-3">
                <a href="{{ path('app_home') }}" title="Home"
                   class="p-1.5 -ml-1.5 rounded-md text-gray-400 hover:bg-gray-100 hover:text-gray-900 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                         stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10"/>
                    </svg>
                </a>
                <h1 class="text-lg font-bold text-gray-900 tracking-tight">Categories</h1>
            </div>
            <div class="flex items-center gap-3 sm:gap-4">
                <span
                    class="hidden sm:inline text-sm text-gray-500">{{ app.user ? app.user.user.name : 'Guest' }}</span>
                {% if app.user %}
                    <a href="{{ logout_path() }}" class="text-sm text-black hover:underline font-medium">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-sm text-black hover:underline font-medium">Sign in</a>
                {% endif %}
            </div>
        </header>

        <main class="max-w-2xl mx-auto px-4 py-6 sm:py-10">

            {# Back link #}
            <a href="{{ path('app_category_index') }}"
               class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-800 font-medium mb-5 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to list
            </a>

            <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-8">
                <h2 class="text-lg font-semibold text-gray-900 mb-1">Create Category</h2>
                <p class="text-sm text-gray-400 mb-6">Which type of category would you like to create?</p>

                <div class="space-y-3">

                    {# Expense #}
                    <a href="{{ path('app_category_new') }}"
                       class="flex items-center gap-4 border border-gray-200 rounded-lg px-4 py-4 hover:border-gray-900 hover:bg-gray-50 transition">
                        <div
                            class="w-10 h-10 rounded-full bg-gray-100 text-gray-900 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900">Expense</p>
                            <p class="text-xs text-gray-400 mt-0.5">Money you spend</p>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>

                    {# Income #}
                    <a href="{{ path('app_category_new_income') }}"
                       class="flex items-center gap-4 border border-gray-200 rounded-lg px-4 py-4 hover:border-gray-900 hover:bg-gray-50 transition">
                        <div
                            class="w-10 h-10 rounded-full bg-gray-100 text-gray-900 flex items-center justify-center shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900">Income</p>
                            <p class="text-xs text-gray-400 mt-0.5">Money you receive</p>
                        </div>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>

                </div>
            </div>

        </main>
    </div>
{% endblock %}
