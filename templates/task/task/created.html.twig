{% extends 'base.html.twig' %}

{% block title %}Task Created{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100">

    <header class="bg-white border-b border-gray-200 px-4 sm:px-6 py-4 flex items-center justify-between">
        <h1 class="text-lg font-bold text-gray-900 tracking-tight">Task Manager</h1>
        <div class="flex items-center gap-3 sm:gap-4">
            <span class="hidden sm:inline text-sm text-gray-500">{{ app.user ? app.user.userIdentifier : 'Guest' }}</span>
            {% if app.user %}
                <a href="{{ logout_path() }}" class="text-sm text-black hover:underline font-medium">Logout</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="text-sm text-black hover:underline font-medium">Sign in</a>
            {% endif %}
        </div>
    </header>

    <main class="max-w-2xl mx-auto px-4 py-6 sm:py-10">

        <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-8 text-center">

            <div class="flex items-center justify-center w-14 h-14 rounded-full bg-green-100 mx-auto mb-5">
                <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
            </div>

            <h2 class="text-xl font-bold text-gray-900 mb-2">Task Created</h2>
            <p class="text-sm text-gray-500 mb-8">Your task has been successfully created.</p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <a
                    href="{{ path('app_home') }}"
                    class="w-full sm:w-auto text-center border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium px-6 py-2.5 rounded-lg transition"
                >
                    Back to Home
                </a>
                <a
                    href="{{ path('app_task_create') }}"
                    class="w-full sm:w-auto text-center bg-black hover:bg-gray-800 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition"
                >
                    Create Another Task
                </a>
            </div>

        </div>

    </main>
</div>
{% endblock %}
