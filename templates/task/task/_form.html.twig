{% set submit_label = submit_label|default('Save') %}

{{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}

    <div>
        {{ form_label(form.value, 'Title', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.value, {'attr': {
            'class': 'w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition',
            'placeholder': 'e.g. Fix login page bug',
            'autofocus': true
        }}) }}
        {{ form_errors(form.value) }}
    </div>

    <div>
        {{ form_label(form.description, 'Description', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.description, {'attr': {
            'class': 'w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition resize-none',
            'rows': 4,
            'placeholder': 'Optional details about this task...'
        }}) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
            {{ form_label(form.due_date, 'Due Date', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.due_date, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition'}}) }}
            {{ form_errors(form.due_date) }}
        </div>

        <div>
            {{ form_label(form.status, 'Status', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
            {{ form_widget(form.status, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition bg-white'}}) }}
            {{ form_errors(form.status) }}
        </div>
    </div>

    <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-end gap-3 pt-2">
        <a href="{{ path('app_home') }}"
           class="text-center text-sm text-gray-500 hover:text-gray-800 font-medium transition py-2.5 sm:py-0">Cancel</a>
        <button
            type="submit"
            class="w-full sm:w-auto bg-black hover:bg-gray-800 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition"
        >
            {{ submit_label }}
        </button>
    </div>

{{ form_end(form) }}