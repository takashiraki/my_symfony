{% extends 'base.html.twig' %}

{% block title %}Edit Task{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100">

        {# Navbar #}
        <header class="bg-white border-b border-gray-200 px-4 sm:px-6 py-4 flex items-center justify-between">
            <h1 class="text-lg font-bold text-gray-900 tracking-tight">Task Manager</h1>
            <div class="flex items-center gap-3 sm:gap-4">
                <span
                    class="hidden sm:inline text-sm text-gray-500">{{ app.user ? app.user.userIdentifier : 'Guest' }}</span>
                {% if app.user %}
                    <a href="{{ logout_path() }}" class="text-sm text-black hover:underline font-medium">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-sm text-black hover:underline font-medium">Sign in</a>
                {% endif %}
            </div>
        </header>

        <main class="max-w-2xl mx-auto px-4 py-6 sm:py-10">

            {# Back link #}
            <a href="{{ path('app_home') }}"
               class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-800 mb-6 transition">
                ← Back to tasks
            </a>

            <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-8">
                <h2 class="text-xl font-bold text-gray-900 mb-1">Edit Task</h2>
                <p class="text-sm text-gray-500 mb-6">Update the details below and save your changes.</p>

                {{ include('task/task/_form.html.twig', {'submit_label': 'Save Changes'}) }}
            </div>

        </main>
    </div>
{% endblock %}