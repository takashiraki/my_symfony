{% extends 'base.html.twig' %}

{% block title %}Task Manager{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 flex flex-col">

    {# Navbar #}
    <header class="bg-white border-b border-gray-200 px-4 sm:px-6 py-4 flex items-center justify-between">
        <h1 class="text-lg font-bold text-gray-900 tracking-tight">Task Manager</h1>
        <div class="flex items-center gap-3 sm:gap-4">
            <span class="hidden sm:inline text-sm text-gray-500">{{ app.user ? app.user.user.name : 'Guest' }}</span>
            {% if app.user %}
                <a href="{{ logout_path() }}" class="text-sm text-black hover:underline font-medium">Logout</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="text-sm text-black hover:underline font-medium">Sign in</a>
            {% endif %}
        </div>
    </header>

    {% if tasks is empty %}

        {# Empty state — centered invitation, no stats or list #}
        <main class="flex-1 flex flex-col items-center justify-center px-4 py-16 text-center">
            <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
            </div>
            <h2 class="text-lg font-semibold text-gray-900">No tasks yet</h2>
            <p class="text-sm text-gray-400 mt-1 mb-6">Create your first task to get started.</p>
            <a href="{{ path('app_task_create') }}" class="bg-black hover:bg-gray-800 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition">
                + New Task
            </a>
        </main>

    {% else %}

        <main class="max-w-3xl w-full mx-auto px-4 py-6 sm:py-10">

            {# Summary cards #}
            <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-6 sm:mb-8">
                <div class="bg-white rounded-2xl shadow-sm p-3 sm:p-5 text-center">
                    <p class="text-2xl sm:text-3xl font-bold text-gray-900">{{ total }}</p>
                    <p class="text-xs sm:text-sm text-gray-500 mt-1">Total</p>
                </div>
                <div class="bg-white rounded-2xl shadow-sm p-3 sm:p-5 text-center">
                    <p class="text-2xl sm:text-3xl font-bold text-yellow-500">{{ progress }}</p>
                    <p class="text-xs sm:text-sm text-gray-500 mt-1">In Progress</p>
                </div>
                <div class="bg-white rounded-2xl shadow-sm p-3 sm:p-5 text-center">
                    <p class="text-2xl sm:text-3xl font-bold text-green-500">{{ done }}</p>
                    <p class="text-xs sm:text-sm text-gray-500 mt-1">Done</p>
                </div>
            </div>

            {# Task list header #}
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-base font-semibold text-gray-800">Your Tasks</h2>
                <a href="{{ path('app_task_create') }}" class="hidden sm:block bg-black hover:bg-gray-800 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
                    + New Task
                </a>
            </div>

            {# Task list #}
            <div class="bg-white rounded-2xl shadow-sm divide-y divide-gray-100">
                {% for task in tasks %}
                    {% set status = task.status.value %}
                    {% set is_done = status == 'done' %}
                    {# Task item #}
                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 px-4 sm:px-5 py-4{{ is_done ? ' opacity-60' }}">
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate{{ is_done ? ' line-through' }}">{{ task.value }}</p>
                            {% if task.dueDate %}
                                <p class="text-xs text-gray-400 mt-0.5">Due: {{ task.dueDate|date('Y-m-d') }}</p>
                            {% endif %}
                        </div>
                        <div class="flex items-center justify-between sm:justify-end sm:gap-3">
                            {% if status == 'in_progress' %}
                                <span class="text-xs font-medium bg-yellow-100 text-yellow-700 px-2.5 py-1 rounded-full whitespace-nowrap">In Progress</span>
                            {% elseif status == 'done' %}
                                <span class="text-xs font-medium bg-green-100 text-green-700 px-2.5 py-1 rounded-full whitespace-nowrap">Done</span>
                            {% else %}
                                <span class="text-xs font-medium bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full whitespace-nowrap">Todo</span>
                            {% endif %}
                            <div class="flex items-center gap-1">
                                <button title="Complete" class="p-1.5 rounded-md text-green-500 hover:bg-green-50 transition"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></button>
                                <button title="Edit" class="p-1.5 rounded-md text-gray-400 hover:bg-gray-100 transition"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.828a2 2 0 01-1.415.586H8v-2.414a2 2 0 01.586-1.414z"/></svg></button>
                                <button title="Delete" class="p-1.5 rounded-md text-gray-400 hover:bg-red-50 hover:text-red-500 transition"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0a1 1 0 011-1h4a1 1 0 011 1m-7 0H5m14 0h-2"/></svg></button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

        </main>

        {# FAB — mobile only #}
        <a href="{{ path('app_task_create') }}" class="sm:hidden fixed bottom-6 left-1/2 -translate-x-1/2 w-14 h-14 bg-black hover:bg-gray-800 text-white rounded-full shadow-lg flex items-center justify-center transition">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
        </a>

    {% endif %}
</div>
{% endblock %}
