{% extends 'base.html.twig' %}

{% block title %}Task Manager{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100 flex flex-col">

        {# Navbar #}
        <header class="bg-white border-b border-gray-200 px-4 sm:px-6 py-4 flex items-center justify-between">
            <h1 class="text-lg font-bold text-gray-900 tracking-tight">Task Manager</h1>
            <div class="flex items-center gap-3 sm:gap-4">
                <span
                    class="hidden sm:inline text-sm text-gray-500">{{ app.user ? app.user.user.name : 'Guest' }}</span>
                {% if app.user %}
                    <a href="{{ logout_path() }}" class="text-sm text-black hover:underline font-medium">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-sm text-black hover:underline font-medium">Sign in</a>
                {% endif %}
            </div>
        </header>

        {% if tasks is empty %}

            {# Empty state — centered invitation, no stats or list #}
            <main class="flex-1 flex flex-col items-center justify-center px-4 py-16 text-center">
                <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mb-5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                    </svg>
                </div>
                <h2 class="text-lg font-semibold text-gray-900">No tasks yet</h2>
                <p class="text-sm text-gray-400 mt-1 mb-6">Create your first task to get started.</p>
                <a href="{{ path('app_task_create') }}"
                   class="bg-black hover:bg-gray-800 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition">
                    + New Task
                </a>
            </main>

        {% else %}

            <main class="max-w-3xl w-full mx-auto px-4 py-6 sm:py-10">

                {# Summary cards #}
                <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-6 sm:mb-8">
                    <div class="bg-white rounded-2xl shadow-sm p-3 sm:p-5 text-center">
                        <p class="text-2xl sm:text-3xl font-bold text-gray-900">{{ total }}</p>
                        <p class="text-xs sm:text-sm text-gray-500 mt-1">Total</p>
                    </div>
                    <div class="bg-white rounded-2xl shadow-sm p-3 sm:p-5 text-center">
                        <p class="text-2xl sm:text-3xl font-bold text-yellow-500">{{ progress }}</p>
                        <p class="text-xs sm:text-sm text-gray-500 mt-1">In Progress</p>
                    </div>
                    <div class="bg-white rounded-2xl shadow-sm p-3 sm:p-5 text-center">
                        <p class="text-2xl sm:text-3xl font-bold text-green-500">{{ done }}</p>
                        <p class="text-xs sm:text-sm text-gray-500 mt-1">Done</p>
                    </div>
                </div>

                {# Task list header #}
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-base font-semibold text-gray-800">Your Tasks</h2>
                    <a href="{{ path('app_task_create') }}"
                       class="hidden sm:block bg-black hover:bg-gray-800 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
                        + New Task
                    </a>
                </div>

                {# Task list #}
                <div class="bg-white rounded-2xl shadow-sm divide-y divide-gray-100">
                    {% for task in tasks %}
                        {% set status = task.status.value %}
                        {% set is_done = status == 'done' %}
                        {# Task item #}
                        <div
                            class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 px-4 sm:px-5 py-4{{ is_done ? ' opacity-60' }}">
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-gray-900 truncate{{ is_done ? ' line-through' }}">{{ task.value }}</p>
                                {% if task.dueDate %}
                                    <p class="text-xs text-gray-400 mt-0.5">Due: {{ task.dueDate|date('Y-m-d') }}</p>
                                {% endif %}
                            </div>
                            <div class="flex items-center justify-between sm:justify-end sm:gap-3">
                                {% if status == 'in_progress' %}
                                    <span
                                        class="text-xs font-medium bg-yellow-100 text-yellow-700 px-2.5 py-1 rounded-full whitespace-nowrap">In Progress</span>
                                {% elseif status == 'done' %}
                                    <span
                                        class="text-xs font-medium bg-green-100 text-green-700 px-2.5 py-1 rounded-full whitespace-nowrap">Done</span>
                                {% else %}
                                    <span
                                        class="text-xs font-medium bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full whitespace-nowrap">Todo</span>
                                {% endif %}
                                <div class="flex items-center gap-1">
                                    <form method="post" action="{{ path('app_task_complete', {id : task.id}) }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('task_create') }}">
                                        <button type="submit" title="Complete"
                                                class="p-1.5 rounded-md text-green-500 hover:bg-green-50 transition">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none"
                                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                      d="M5 13l4 4L19 7"/>
                                            </svg>
                                        </button>
                                    </form>
                                    <a href="{{ path('app_task_edit', {id: task.id}) }}" title="Edit"
                                       class="p-1.5 rounded-md text-gray-400 hover:bg-gray-100 transition">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none"
                                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                  d="M15.232 5.232l3.536 3.536M9 13l6.586-6.586a2 2 0 012.828 2.828L11.828 15.828a2 2 0 01-1.415.586H8v-2.414a2 2 0 01.586-1.414z"/>
                                        </svg>
                                    </a>
                                    <form method="post" action="{{ path('app_task_delete', {id : task.id}) }}">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('task_create') }}">
                                        <button title="Delete"
                                                type="submit"
                                                class="p-1.5 rounded-md text-gray-400 hover:bg-red-50 hover:text-red-500 transition">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none"
                                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7h6m-7 0a1 1 0 011-1h4a1 1 0 011 1m-7 0H5m14 0h-2"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </main>

            {# FAB — mobile only #}
            <a href="{{ path('app_task_create') }}"
               class="sm:hidden fixed bottom-6 left-1/2 -translate-x-1/2 w-14 h-14 bg-black hover:bg-gray-800 text-white rounded-full shadow-lg flex items-center justify-center transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
            </a>

        {% endif %}

        {# ============================================================= #}
        {# Budget dashboard                                               #}
        {# (income / expense / balance from real data; list is sample)    #}
        {# ============================================================= #}
        {% set transactions = [
            { name: 'Starbucks Coffee',     category: 'Food & Drink',  amount: -5.40,   date: 'Today 10:30', tint: 'amber' },
            { name: 'Salary Deposit',       category: 'Income',        amount: 2500.00, date: 'Yesterday',   tint: 'green' },
            { name: 'Amazon Purchase',      category: 'Shopping',      amount: -72.65,  date: 'Yesterday',   tint: 'blue'  },
            { name: 'Netflix Subscription', category: 'Entertainment', amount: -15.99,  date: '2 days ago',  tint: 'rose'  },
            { name: 'Electricity Bill',     category: 'Utilities',     amount: -84.00,  date: '3 days ago',  tint: 'amber' },
            { name: 'Groceries',            category: 'Food & Drink',  amount: -43.20,  date: '4 days ago',  tint: 'green' },
        ] %}

        <main class="max-w-3xl w-full mx-auto px-4 pb-10 sm:pb-16">

            <h2 class="text-base font-semibold text-gray-800 mb-4">Budget</h2>

            {# Balance card #}
            <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-8 mb-6 sm:mb-8">
                <p class="text-xs sm:text-sm text-gray-500">Current Balance</p>
                <p class="text-3xl sm:text-4xl font-bold {{ balance < 0 ? 'text-red-500' : 'text-gray-900' }} mt-1 tracking-tight">
                    {{ balance < 0 ? '-' }}¥{{ (balance|abs)|number_format }}</p>
            </div>

            {# Income / Expenses summary #}
            <div class="grid grid-cols-2 gap-3 sm:gap-4 mb-6 sm:mb-8">
                <div class="bg-white rounded-2xl shadow-sm p-4 sm:p-5">
                    <p class="text-xs sm:text-sm text-gray-500">Income</p>
                    <p class="text-xl sm:text-2xl font-bold text-green-500 mt-1">
                        +¥{{ income|number_format }}</p>
                </div>
                <div class="bg-white rounded-2xl shadow-sm p-4 sm:p-5">
                    <p class="text-xs sm:text-sm text-gray-500">Expenses</p>
                    <p class="text-xl sm:text-2xl font-bold text-red-500 mt-1">
                        -¥{{ expense|number_format }}</p>
                </div>
            </div>

            {# Quick actions #}
            <div class="grid grid-cols-4 gap-3 sm:gap-4 mb-6 sm:mb-8">
                {% set actions = [
                    { label: 'Income',  icon: 'M12 4v16m8-8H4' },
                    { label: 'Expense', icon: 'M20 12H4' },
                    { label: 'Payment Methods', icon: 'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2h10a2 2 0 002-2v-2m0-4V9m0 4h-4', href: path('app_payment_source_index') },
                    { label: 'More',    icon: 'M4 12h.01M12 12h.01M20 12h.01' },
                ] %}
                {% for action in actions %}
                    <a href="{{ action.href|default('#') }}"
                       {% if action.label == 'More' %}data-category-open{% endif %}
                       class="bg-white rounded-2xl shadow-sm py-4 flex flex-col items-center gap-2 hover:shadow-md transition cursor-pointer">
                        <span class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="{{ action.icon }}"/>
                            </svg>
                        </span>
                        <span class="text-xs font-medium text-gray-700 text-center">{{ action.label }}</span>
                    </a>
                {% endfor %}
            </div>

            {# Transactions header #}
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-semibold text-gray-800">Transactions</h3>
                <a href="{{ path('app_money_diary_index') }}" class="text-sm text-gray-500 hover:text-black hover:underline font-medium">See all</a>
            </div>

            {# Transactions list #}
            <div class="bg-white rounded-2xl shadow-sm divide-y divide-gray-100">
                {% set tints = {
                    amber: 'bg-amber-100 text-amber-700',
                    green: 'bg-green-100 text-green-700',
                    blue:  'bg-blue-100 text-blue-700',
                    rose:  'bg-rose-100 text-rose-700',
                } %}
                {% for tx in transactions %}
                    {% set is_income = tx.amount >= 0 %}
                    <div class="flex items-center gap-3 sm:gap-4 px-4 sm:px-5 py-4">
                        <div class="w-28 sm:w-32 shrink-0">
                            <span
                                class="{{ tints[tx.tint] }} inline-block w-full text-center text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap truncate">
                                {{ tx.category }}
                            </span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate">{{ tx.name }}</p>
                        </div>
                        <div class="text-right shrink-0">
                            <p class="text-sm font-semibold {{ is_income ? 'text-green-600' : 'text-gray-900' }}">
                                {{ is_income ? '+' : '-' }}${{ (tx.amount|abs)|number_format(2) }}
                            </p>
                            <p class="text-xs text-gray-400 mt-0.5">{{ tx.date }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>

        </main>

        {# ============================================================= #}
        {# "More" menu modal — links to creation screens                 #}
        {# ============================================================= #}
        {% set menu_items = [
            {
                label: 'Category',
                desc:  'Management spending categories',
                href:  path('app_category_index'),
                icon:  'M3 7h18M3 12h18M3 17h18',
            },
            {
                label: 'Genre',
                desc:  'Management genre tags',
                href:  '#',
                icon:  'M7 7h.01M7 3h5a1.99 1.99 0 011.414.586l7 7a2 2 0 010 2.828l-5 5a2 2 0 01-2.828 0l-7-7A1.99 1.99 0 014 12V7a4 4 0 014-4z',
            },
        ] %}

        <div data-more-modal
             class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
            {# Backdrop #}
            <div data-more-close class="absolute inset-0 bg-black/40"></div>

            {# Panel #}
            <div
                class="relative bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-2xl shadow-xl max-h-[85vh] flex flex-col">
                <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
                    <h3 class="text-base font-semibold text-gray-900">More</h3>
                    <button type="button" data-more-close
                            class="p-1.5 rounded-md text-gray-400 hover:bg-gray-100 transition">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>

                <div class="p-3 sm:p-4 overflow-y-auto divide-y divide-gray-100">
                    {% for item in menu_items %}
                        <a href="{{ item.href }}"
                           class="flex items-center gap-4 px-3 py-4 rounded-xl hover:bg-gray-50 transition">
                            <span class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" fill="none"
                                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="{{ item.icon }}"/>
                                </svg>
                            </span>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-gray-900">{{ item.label }}</p>
                                <p class="text-xs text-gray-400 mt-0.5">{{ item.desc }}</p>
                            </div>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300 shrink-0" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

    </div>

    <script>
        (function () {
            const modal = document.querySelector('[data-more-modal]');
            if (!modal) return;

            const open = () => modal.classList.remove('hidden');
            const close = () => modal.classList.add('hidden');

            document.querySelectorAll('[data-category-open]').forEach(el => el.addEventListener('click', e => {
                e.preventDefault();
                open();
            }));
            modal.querySelectorAll('[data-more-close]').forEach(el => el.addEventListener('click', close));

            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') close();
            });
        })();
    </script>
{% endblock %}
