{% extends 'base.html.twig' %}

{% block title %}Payment Source{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
    {% set type_labels = {
        'credit_card':   'Credit Card',
        'paypal':        'PayPal',
        'cash':          'Cash',
        'bank_transfer': 'Bank Transfer',
    } %}
    {% set type_tints = {
        'credit_card':   'bg-blue-100 text-blue-700',
        'paypal':        'bg-indigo-100 text-indigo-700',
        'cash':          'bg-green-100 text-green-700',
        'bank_transfer': 'bg-amber-100 text-amber-700',
    } %}
    {% set type = payment_source.type.value %}

    <div class="min-h-screen bg-gray-100">

        {# Navbar #}
        <header class="bg-white border-b border-gray-200 px-4 sm:px-6 py-4 flex items-center justify-between">
            <h1 class="text-lg font-bold text-gray-900 tracking-tight">Payment Sources</h1>
            <div class="flex items-center gap-3 sm:gap-4">
                <span class="hidden sm:inline text-sm text-gray-500">{{ app.user ? app.user.user.name : 'Guest' }}</span>
                {% if app.user %}
                    <a href="{{ logout_path() }}" class="text-sm text-black hover:underline font-medium">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-sm text-black hover:underline font-medium">Sign in</a>
                {% endif %}
            </div>
        </header>

        <main class="max-w-2xl mx-auto px-4 py-6 sm:py-10">

            {# Back link #}
            <a href="{{ path('app_payment_source_index') }}"
               class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-800 font-medium mb-5 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                     stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
                </svg>
                Back to list
            </a>

            <div class="bg-white rounded-2xl shadow-sm p-6 sm:p-8">

                {# Header #}
                <div class="flex items-start justify-between gap-4 mb-6">
                    <div class="min-w-0">
                        <p class="text-xs text-gray-400">Payment Source</p>
                        <h2 class="text-xl font-bold text-gray-900 truncate">{{ payment_source.name }}</h2>
                    </div>
                    <span class="{{ type_tints[type] ?? 'bg-gray-100 text-gray-600' }} text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap shrink-0">
                        {{ type_labels[type] ?? type }}
                    </span>
                </div>

                {# Details #}
                <dl class="divide-y divide-gray-100 border-t border-gray-100">
                    <div class="flex items-center justify-between py-3">
                        <dt class="text-sm text-gray-500">Name</dt>
                        <dd class="text-sm font-medium text-gray-900">{{ payment_source.name }}</dd>
                    </div>
                    <div class="flex items-center justify-between py-3">
                        <dt class="text-sm text-gray-500">Type</dt>
                        <dd class="text-sm font-medium text-gray-900">{{ type_labels[type] ?? type }}</dd>
                    </div>
                </dl>

                {# Actions #}
                <div class="flex items-center justify-end gap-3 pt-6">
                    <form method="post" action="{{ path('app_payment_source_delete', {'id': payment_source.id}) }}"
                          onsubmit="return confirm('Are you sure you want to delete this payment source?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ payment_source.id) }}">
                        <button type="submit"
                                class="text-sm text-gray-500 hover:text-red-500 font-medium transition px-4 py-2.5">
                            Delete
                        </button>
                    </form>
                    <a href="{{ path('app_payment_source_edit', {'id': payment_source.id}) }}"
                       class="bg-black hover:bg-gray-800 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition">
                        Edit
                    </a>
                </div>

            </div>

        </main>
    </div>
{% endblock %}