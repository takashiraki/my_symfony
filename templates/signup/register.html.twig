{% extends 'base.html.twig' %}

{% block title %}Complete Your Profile{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% set input_class = 'w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition' %}

{% block body %}
    <div class="min-h-screen bg-gray-100 flex items-center justify-center px-4">
        <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 w-full max-w-md">
            <h1 class="text-2xl font-bold text-gray-800 mb-2 text-center">Complete your profile</h1>
            <p class="text-sm text-gray-500 text-center mb-6">
                Your email has been verified. Just a few more details.
            </p>

            {% if form.vars.value.email %}
                <div class="bg-gray-50 border border-gray-200 text-sm rounded-lg px-4 py-3 mb-6 flex items-center justify-between">
                    <span class="text-gray-500">Email</span>
                    <span class="font-medium text-gray-800">{{ form.vars.value.email }}</span>
                </div>
            {% endif %}

            {% if not form.vars.valid %}
                <div class="bg-red-50 border border-red-200 text-red-600 text-sm rounded-lg px-4 py-3 mb-4">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
                <div>
                    <label for="{{ form.user.name.vars.id }}" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                    {{ form_widget(form.user.name, {attr: {class: input_class, placeholder: 'John Doe'}}) }}
                    {{ form_errors(form.user.name) }}
                </div>

                <div>
                    <label for="{{ form.user.country.vars.id }}" class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                    {{ form_widget(form.user.country, {attr: {class: input_class ~ ' bg-white'}}) }}
                    {{ form_errors(form.user.country) }}
                </div>

                <div>
                    <label for="{{ form.password.vars.id }}" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                    {{ form_widget(form.password, {attr: {class: input_class, placeholder: '••••••••'}}) }}
                    {{ form_errors(form.password) }}
                </div>

                <button
                    type="submit"
                    class="w-full bg-black hover:bg-gray-800 text-white font-semibold py-2.5 rounded-lg transition text-sm"
                >
                    Complete Registration
                </button>
            {{ form_end(form) }}

            <p class="mt-6 text-center text-sm text-gray-500">
                Already have an account?
                <a href="{{ path('app_login') }}" class="text-black font-medium hover:underline">Sign in</a>
            </p>
        </div>
    </div>
{% endblock %}