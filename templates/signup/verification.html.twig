{% extends 'base.html.twig' %}

{% block title %}Check Your Email{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100 flex items-center justify-center px-4">
        <div class="bg-white rounded-2xl shadow-lg p-6 sm:p-8 w-full max-w-md text-center">
            <div class="mx-auto mb-5 w-14 h-14 rounded-full bg-gray-100 flex items-center justify-center">
                <svg class="w-7 h-7 text-gray-800" fill="none" stroke="currentColor" stroke-width="1.8"
                     viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
            </div>

            <h1 class="text-2xl font-bold text-gray-800 mb-2">Check your email</h1>
            <p class="text-sm text-gray-500 mb-6">
                We've sent a verification link to
                {% if email is defined and email %}
                    <span class="font-medium text-gray-800">{{ email }}</span>.
                {% else %}
                    your email address.
                {% endif %}
                <br>
                Please click the link in the email to continue.
            </p>

            <div class="bg-gray-50 border border-gray-200 text-gray-600 text-sm rounded-lg px-4 py-3 mb-6 text-left">
                Didn't receive the email? Check your spam folder, or try signing up again
                with the correct email address.
            </div>

            <a href="{{ path('app_sign_up') }}"
               class="w-full block bg-black hover:bg-gray-800 text-white font-semibold py-2.5 rounded-lg transition text-sm">
                Back to Sign Up
            </a>

            <p class="mt-6 text-sm text-gray-500">
                Already verified?
                <a href="{{ path('app_login') }}" class="text-black font-medium hover:underline">Sign in</a>
            </p>
        </div>
    </div>
{% endblock %}